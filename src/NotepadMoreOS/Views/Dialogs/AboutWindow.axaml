<Window
        xmlns:loc="using:NotepadMoreOS.Resources" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:Markdown.Avalonia"
        xmlns:vm="using:NotepadMoreOS.ViewModels"
        x:DataType="vm:UpdateCheckViewModel"
        x:Class="NotepadMoreOS.Views.Dialogs.AboutWindow"
        Title="{x:Static loc:Strings.Menu_About}"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Border Padding="30,28,30,22">
    <StackPanel Spacing="18">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Image Source="/Assets/appicon.png"
               Width="58"
               Height="58"
               Stretch="Uniform" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock FontSize="24" FontWeight="SemiBold">
            <Run Text="Notepad" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Run Text="More" Foreground="#43DCE2" />
            <Run Text="OS" Foreground="{DynamicResource TextSecondaryBrush}" />
          </TextBlock>
          <TextBlock x:Name="VersionText"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{x:Static loc:Strings.About_Description}"
                 FontSize="13"
                 LineHeight="20"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <Border Background="{DynamicResource ChromeBackgroundAltBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static loc:Strings.About_BuiltWith}" Classes="section-title" />
          <TextBlock Text="Avalonia 12  ·  .NET 10  ·  AvaloniaEdit  ·  TextMate grammars"
                     FontSize="12.5"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{x:Static loc:Strings.About_License}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Expander Header="{x:Static loc:Strings.About_Changelog}">
        <md:MarkdownScrollViewer x:Name="ChangelogViewer" Height="280" />
      </Expander>

      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static loc:Strings.About_CheckUpdates}" Command="{Binding CheckCommand}" />
          <Button Content="{x:Static loc:Strings.About_OpenRelease}" IsVisible="{Binding UpdateAvailable}" Click="OnReleaseClick" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{x:Static loc:Strings.About_GitHubButton}"
                Classes="ghost"
                Click="OnRepositoryClick" />
        <Button Content="{x:Static loc:Strings.About_ProjectButton}"
                Classes="ghost"
                Click="OnProjectClick" />
        <Button Content="{x:Static loc:Strings.Chrome_Close}"
                Classes="accent"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
