<UserControl
        xmlns:loc="using:NotepadMoreOS.Resources" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:controls="using:NotepadMoreOS.Controls"
             xmlns:vm="using:NotepadMoreOS.ViewModels"
             x:Class="NotepadMoreOS.Views.DocumentView"
             x:DataType="vm:DocumentViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource EditorBackgroundBrush}">
    <Button HorizontalAlignment="Right"
            IsVisible="{Binding SupportsMarkdownPreview}"
            Command="{Binding ToggleMarkdownPreviewCommand}"
            AutomationProperties.Name="{x:Static loc:Strings.Menu_MarkdownPreview}"
            ToolTip.Tip="{x:Static loc:Strings.Menu_MarkdownPreview}">
      <TextBlock Text="◫" />
    </Button>
    <Grid Name="EditorLayout" Grid.Row="1" RowDefinitions="*,Auto,0">
    <controls:NotepadTextEditor Grid.Row="0" Name="Editor"
                     Options="{Binding DisplayOptions}"
                     WordWrap="{Binding EffectiveWordWrap}"
                     ShowLineNumbers="{Binding EditorSettings.ShowLineNumbers}"
                     FontFamily="{Binding EditorSettings.EditorFontFamily}"
                     FontSize="{Binding EffectiveFontSize}"
                     IsReadOnly="{Binding IsReadOnly}"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     LineNumbersMargin="12,4,16,0"
                     Background="{DynamicResource EditorBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Padding="0,4,0,0">
      <controls:NotepadTextEditor.ContextFlyout>
        <MenuFlyout>
          <MenuItem Header="{x:Static loc:Strings.Menu_Undo}" Click="OnUndoClick" />
          <MenuItem Header="{x:Static loc:Strings.Menu_Redo}" Click="OnRedoClick" />
          <Separator />
          <MenuItem Header="{x:Static loc:Strings.Menu_Cut}" Click="OnCutClick" />
          <MenuItem Header="{x:Static loc:Strings.Menu_Copy}" Click="OnCopyClick" />
          <MenuItem Header="{x:Static loc:Strings.Menu_Paste}" Click="OnPasteClick" />
          <Separator />
          <MenuItem Header="Duplicate line" Click="OnDuplicateLineClick" />
          <MenuItem Header="Delete line" Click="OnDeleteLineClick" />
          <MenuItem Header="Toggle comment" Click="OnToggleCommentClick" />
          <Separator />
          <MenuItem Header="Select all" Click="OnSelectAllClick" />
        </MenuFlyout>
      </controls:NotepadTextEditor.ContextFlyout>
    </controls:NotepadTextEditor>
    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                  Background="{DynamicResource AccentBrush}"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  IsVisible="{Binding ShowMarkdownPreview}" />
    <Border Grid.Row="2" IsVisible="{Binding ShowMarkdownPreview}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AccentBrush}">
      <Grid RowDefinitions="Auto,*">
        <Button HorizontalAlignment="Right" Content="×"
                AutomationProperties.Name="{x:Static loc:Strings.Chrome_Close}"
                Command="{Binding ToggleMarkdownPreviewCommand}" />
        <md:MarkdownScrollViewer Grid.Row="1" Markdown="{Binding PreviewMarkdown}" />
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
