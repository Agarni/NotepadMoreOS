<Window
        xmlns:loc="using:NotepadMoreOS.Resources" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotepadMoreOS.ViewModels"
        xmlns:views="using:NotepadMoreOS.Views"
        xmlns:controls="using:NotepadMoreOS.Controls"
        xmlns:models="using:NotepadMoreOS.Models"
        xmlns:services="using:NotepadMoreOS.Services"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="NotepadMoreOS.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="880"
        MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/appicon.png"
        Closing="OnClosing">

  <Window.KeyBindings>
    <KeyBinding Gesture="{controls:Mod Key=N}" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=O}" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=S}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=S, Modifiers=Shift}" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=S, Modifiers=Alt}" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=W}" Command="{Binding CloseTabCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=W, Modifiers=Shift}" Command="{Binding CloseAllCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=F}" Command="{Binding OpenFindCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=F, Modifiers=Alt}" Command="{Binding OpenReplaceCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=F, Modifiers=Shift}" Command="{Binding FindInFilesCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=G}" Command="{Binding GoToLineCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=D}" Command="{Binding DuplicateLineCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=L}" Command="{Binding DeleteLineCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=C, Modifiers=Alt}" Command="{Binding ToggleCommentCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding InsertDateTimeCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseFindCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousDocumentCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=OemPlus}" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=OemMinus}" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=D0}" Command="{Binding ZoomResetCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=W, Modifiers=Alt}" Command="{Binding ToggleWordWrapCommand}" />
    <KeyBinding Gesture="{controls:Mod Key=OemComma}" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- ============================ Menu bar ============================ -->
    <Menu Grid.Row="0" x:Name="AppMenu">
      <MenuItem Header="{x:Static loc:Strings.Menu_File}">
        <MenuItem Header="{x:Static loc:Strings.Menu_New}" HotKey="{controls:Mod Key=N}" Command="{Binding NewDocumentCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Open}" HotKey="{controls:Mod Key=O}" Command="{Binding OpenCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_OpenRecent}" x:Name="RecentMenu" SubmenuOpened="OnRecentMenuOpened" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Save}" HotKey="{controls:Mod Key=S}" Command="{Binding SaveCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_SaveAs}" HotKey="{controls:Mod Key=S, Modifiers=Shift}" Command="{Binding SaveAsCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_SaveAll}" HotKey="{controls:Mod Key=S, Modifiers=Alt}" Command="{Binding SaveAllCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Reload}" Command="{Binding ReloadCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_OpenFolder}" Command="{Binding OpenContainingFolderCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_CopyPath}" Command="{Binding CopyFilePathCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_CloseTab}" HotKey="{controls:Mod Key=W}" Command="{Binding CloseTabCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_CloseAllTabs}" HotKey="{controls:Mod Key=W, Modifiers=Shift}" Command="{Binding CloseAllCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Exit}" Command="{Binding ExitCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_Edit}">
        <MenuItem Header="{x:Static loc:Strings.Menu_Undo}" HotKey="{controls:Mod Key=Z}" Command="{Binding UndoCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Redo}" HotKey="{controls:Mod Key=Z, Modifiers=Shift}" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Cut}" HotKey="{controls:Mod Key=X}" Command="{Binding CutCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Copy}" HotKey="{controls:Mod Key=C}" Command="{Binding CopyCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Paste}" HotKey="{controls:Mod Key=V}" Command="{Binding PasteCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Delete}" Command="{Binding DeleteCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_SelectAll}" HotKey="{controls:Mod Key=A}" Command="{Binding SelectAllCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_DuplicateLine}" HotKey="{controls:Mod Key=D}" Command="{Binding DuplicateLineCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_DeleteLine}" HotKey="{controls:Mod Key=L}" Command="{Binding DeleteLineCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_ToggleComment}" HotKey="{controls:Mod Key=C, Modifiers=Alt}" Command="{Binding ToggleCommentCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_InsertDateTime}" HotKey="F5" Command="{Binding InsertDateTimeCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_Search}">
        <MenuItem Header="{x:Static loc:Strings.Menu_Find}" HotKey="{controls:Mod Key=F}" Command="{Binding OpenFindCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Replace}" HotKey="{controls:Mod Key=F, Modifiers=Alt}" Command="{Binding OpenReplaceCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_FindNext}" HotKey="F3" Command="{Binding FindNextCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_FindPrevious}" HotKey="Shift+F3" Command="{Binding FindPreviousCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_FindAll}" Command="{Binding FindAllCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_FindInFiles}" HotKey="{controls:Mod Key=F, Modifiers=Shift}" Command="{Binding FindInFilesCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_GoToLine}" HotKey="{controls:Mod Key=G}" Command="{Binding GoToLineCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_Encoding}" IsEnabled="{Binding HasDocuments}">
        <MenuItem Header="{x:Static loc:Strings.Menu_ReopenEncoding}" x:Name="ReopenEncodingMenu" SubmenuOpened="OnReopenEncodingMenuOpened" />
        <MenuItem Header="{x:Static loc:Strings.Menu_SaveEncoding}" x:Name="SaveEncodingMenu" SubmenuOpened="OnSaveEncodingMenuOpened" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Reload}" Command="{Binding ReloadCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_View}">
        <MenuItem Header="{x:Static loc:Strings.Menu_WordWrap}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.WordWrap, Mode=TwoWay}" HotKey="{controls:Mod Key=W, Modifiers=Alt}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_LineNumbers}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.ShowLineNumbers, Mode=TwoWay}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_Whitespace}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.ShowWhitespace, Mode=TwoWay}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_EndOfLine}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.ShowEndOfLine, Mode=TwoWay}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_HighlightLine}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.HighlightCurrentLine, Mode=TwoWay}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_ColumnRuler}" ToggleType="CheckBox" IsChecked="{Binding EditorSettings.EnableColumnRuler, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Theme}" x:Name="ThemeMenu" SubmenuOpened="OnThemeMenuOpened" />
        <MenuItem Header="{x:Static loc:Strings.Menu_AccentColor}" x:Name="AccentMenu" SubmenuOpened="OnAccentMenuOpened" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_ZoomIn}" HotKey="{controls:Mod Key=OemPlus}" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_ZoomOut}" HotKey="{controls:Mod Key=OemMinus}" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_ResetZoom}" HotKey="{controls:Mod Key=D0}" Command="{Binding ZoomResetCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_NextTab}" HotKey="Ctrl+Tab" Command="{Binding NextDocumentCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_PreviousTab}" HotKey="Ctrl+Shift+Tab" Command="{Binding PreviousDocumentCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_Settings}">
        <MenuItem Header="{x:Static loc:Strings.Menu_Preferences}" HotKey="{controls:Mod Key=OemComma}" Command="{Binding OpenSettingsCommand}" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:Strings.Menu_Help}">
        <MenuItem Header="{x:Static loc:Strings.Menu_About}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- ============================ Workspace bar ============================ -->
    <Border Grid.Row="1"
            x:Name="WorkspaceBar"
            Background="{DynamicResource WorkspaceBarBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,1"
            Padding="10,7">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <StackPanel x:Name="TrafficLights"
                      Orientation="Horizontal"
                      Spacing="7"
                      Margin="2,0,6,0"
                      VerticalAlignment="Center"
                      IsVisible="False">
            <Button Classes="traffic-light close"
                    Click="OnChromeCloseClick"
                    ToolTip.Tip="{x:Static loc:Strings.Chrome_Close}"
                    automation:AutomationProperties.Name="{x:Static loc:Strings.Chrome_Close}" />
            <Button Classes="traffic-light minimize"
                    Click="OnChromeMinimizeClick"
                    ToolTip.Tip="{x:Static loc:Strings.Chrome_Minimize}"
                    automation:AutomationProperties.Name="{x:Static loc:Strings.Chrome_Minimize}" />
            <Button Classes="traffic-light maximize"
                    Click="OnChromeMaximizeClick"
                    ToolTip.Tip="{x:Static loc:Strings.Chrome_Maximize}"
                    automation:AutomationProperties.Name="{x:Static loc:Strings.Chrome_Maximize}" />
          </StackPanel>

          <Image Source="/Assets/appicon.png"
                 Width="32"
                 Height="32"
                 Stretch="Uniform"
                 ToolTip.Tip="NotepadMoreOS" />

          <Border Classes="toolbar-group">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Button Classes="tool" Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static loc:Strings.Tool_OpenFiles}">
                <Path Data="{StaticResource IconOpen}" />
              </Button>
              <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="{x:Static loc:Strings.Menu_Save}">
                <Path Data="{StaticResource IconSave}" />
              </Button>
              <Button Classes="tool" Command="{Binding SaveAllCommand}" ToolTip.Tip="{x:Static loc:Strings.Menu_SaveAll}">
                <Path Data="{StaticResource IconSaveAll}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="{x:Static loc:Strings.Tool_RecentFiles}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Width="420" MaxHeight="440" Padding="4">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                          <TextBlock Text="{x:Static loc:Strings.Tool_NoRecentFiles}"
                                     FontSize="12"
                                     Margin="10,8"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     IsVisible="{Binding HasNoRecentFiles}" />
                          <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RecentFileViewModel">
                                <Button Classes="recent"
                                        Command="{Binding OpenCommand}"
                                        CommandParameter="{Binding Path}"
                                        ToolTip.Tip="{Binding Path}">
                                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Path Data="{StaticResource IconDocument}"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.4"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontSize="12.5"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                      <TextBlock Text="{Binding Directory}"
                                                 FontSize="11"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                  </Flyout>
                </Button.Flyout>
                <Path Data="{StaticResource IconRecent}" />
              </Button>
            </StackPanel>
          </Border>

          <Border Classes="toolbar-group">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="{x:Static loc:Strings.Menu_Undo}">
                <Path Data="{StaticResource IconUndo}" />
              </Button>
              <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="{x:Static loc:Strings.Menu_Redo}">
                <Path Data="{StaticResource IconRedo}" />
              </Button>
            </StackPanel>
          </Border>

        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button x:Name="SessionButton"
                  Classes="workspace-chip session-chip"
                  ToolTip.Tip="{x:Static loc:Strings.Tool_Sessions}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border Width="340" Padding="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static loc:Strings.Sessions_Header}" Classes="section-title" Margin="6,4,0,2" />
                    <TextBlock Text="{Binding CurrentSessionDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="6,0,6,4" />

                    <TextBlock Text="{x:Static loc:Strings.Sessions_Empty}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="6,2"
                               IsVisible="{Binding HasNoSessions}" />

                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                            <Button Classes="recent"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Session}"
                                    Click="OnSessionFlyoutItemClick"
                                    Padding="7,6">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Name}"
                                             FontSize="12.5"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Details}"
                                             FontSize="10.5"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Path Grid.Column="1"
                                      Data="{StaticResource IconChevronRight}"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.4"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{x:Static loc:Strings.Tool_ManageSession}">
                              <Button.Flyout>
                                <MenuFlyout>
                                  <MenuItem Header="{x:Static loc:Strings.Sessions_Rename}"
                                            Click="OnSessionFlyoutItemClick"
                                            Command="{Binding RenameCommand}"
                                            CommandParameter="{Binding}" />
                                  <MenuItem Header="{x:Static loc:Strings.Menu_Delete}"
                                            Click="OnSessionFlyoutItemClick"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding}" />
                                </MenuFlyout>
                              </Button.Flyout>
                              <TextBlock Text="⋯" FontSize="15" FontWeight="SemiBold" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <Separator Margin="0,4" />
                    <Button Classes="recent"
                            Command="{Binding NewEmptySessionCommand}"
                            Click="OnSessionFlyoutItemClick">
                      <TextBlock Text="{x:Static loc:Strings.Sessions_NewEmpty}" FontSize="12.5" />
                    </Button>
                    <Separator Margin="0,4" />
                    <Button Classes="recent"
                            Command="{Binding SaveCurrentSessionCommand}"
                            Click="OnSessionFlyoutItemClick">
                      <TextBlock Text="{x:Static loc:Strings.Sessions_SaveCurrent}" FontSize="12.5" />
                    </Button>
                    <Button Classes="recent"
                            Command="{Binding SaveSessionAsCommand}"
                            Click="OnSessionFlyoutItemClick">
                      <TextBlock Text="{x:Static loc:Strings.Sessions_SaveAsNew}" FontSize="12.5" />
                    </Button>
                    <Button Classes="recent"
                            Command="{Binding RenameCurrentSessionCommand}"
                            Click="OnSessionFlyoutItemClick"
                            IsEnabled="{Binding CanManageCurrentSession}">
                      <TextBlock Text="{x:Static loc:Strings.Sessions_RenameCurrent}" FontSize="12.5" />
                    </Button>
                    <Button Classes="recent"
                            Command="{Binding DeleteCurrentSessionCommand}"
                            Click="OnSessionFlyoutItemClick"
                            IsEnabled="{Binding CanManageCurrentSession}">
                      <TextBlock Text="{x:Static loc:Strings.Sessions_DeleteCurrent}" FontSize="12.5" />
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
              <Path Data="{StaticResource IconLayers}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding CurrentSessionDisplay}"
                         FontSize="12"
                         FontWeight="Medium"
                         MaxWidth="140"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="10" Height="10" />
            </Grid>
          </Button>

          <Button Classes="language-pill" ToolTip.Tip="{x:Static loc:Strings.Tool_Language}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border Width="260" MaxHeight="380" Padding="6">
                  <ListBox ItemsSource="{Binding Languages}"
                           SelectedItem="{Binding StatusLanguage, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:LanguageInfo">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Flyout>
            </Button.Flyout>
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
              <Ellipse Width="7"
                       Height="7"
                       Fill="{Binding ActiveLanguageAccentBrush}"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ActiveLanguageName}"
                         FontSize="11.5"
                         MaxWidth="105"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2"
                    Data="{StaticResource IconChevronDown}"
                    Stroke="{DynamicResource TextSecondaryBrush}"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Width="10"
                    Height="10"
                    Stretch="Uniform" />
            </Grid>
          </Button>

          <Button Classes="tool" Command="{Binding OpenFindCommand}" ToolTip.Tip="{x:Static loc:Strings.Tool_Find}">
            <Path Data="{StaticResource IconFind}" />
          </Button>
          <Button Classes="tool" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{x:Static loc:Strings.Tool_Settings}">
            <Path Data="{StaticResource IconSettings}" />
          </Button>
          <Button Classes="tool" ToolTip.Tip="{x:Static loc:Strings.Tool_More}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{x:Static loc:Strings.Menu_Reload}" Command="{Binding ReloadCommand}" />
                <MenuItem Header="{x:Static loc:Strings.Menu_OpenFolder}" Command="{Binding OpenContainingFolderCommand}" />
                <MenuItem Header="{x:Static loc:Strings.Menu_CopyPath}" Command="{Binding CopyFilePathCommand}" />
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.Menu_Preferences}" Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="{x:Static loc:Strings.Menu_About}" Command="{Binding ShowAboutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <TextBlock Text="⋯" FontSize="17" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ Tab strip ============================ -->
    <Border Grid.Row="2"
            Classes.tabs-rounded="{Binding TabsRounded}"
            Classes.tabs-floating="{Binding TabsFloating}"
            Classes.tabs-connected="{Binding TabsConnected}"
            Background="{DynamicResource TabBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,2,10,0"
            IsVisible="{Binding HasDocuments}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button x:Name="TabScrollLeft"
                Grid.Column="0"
                Classes="tool"
                Width="18"
                Height="26"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                IsVisible="False"
                Click="OnTabScrollLeftClick"
                ToolTip.Tip="{x:Static loc:Strings.Tabs_ScrollLeft}">
          <Path Data="{StaticResource IconChevronLeft}" />
        </Button>

        <ScrollViewer x:Name="TabScroll"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PointerWheelChanged="OnTabStripPointerWheel">
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Button Classes="tab"
                        Classes.active="{Binding IsActive}"
                        Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding FilePath, FallbackValue='Untitled'}">
                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="{x:Static loc:Strings.Chrome_Close}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="close" />
                      <MenuItem Header="{x:Static loc:Strings.Tab_CloseMultiple}">
                        <MenuItem Header="{x:Static loc:Strings.Tab_CloseOthers}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="close-others" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_CloseRight}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="close-right" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_CloseLeft}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="close-left" />
                        <MenuItem Header="{x:Static loc:Strings.Menu_CloseAllTabs}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="close-all" />
                      </MenuItem>
                      <MenuItem Header="{Binding PinMenuHeader}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="pin" />
                      <Separator />
                      <MenuItem Header="{x:Static loc:Strings.Menu_Save}"
                                IsEnabled="{Binding IsDirty}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="save" />
                      <MenuItem Header="{x:Static loc:Strings.Menu_SaveAs}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="save-as" />
                      <MenuItem Header="{x:Static loc:Strings.Tab_OpenIn}" IsEnabled="{Binding HasFilePath}">
                        <MenuItem Header="{x:Static loc:Strings.Menu_OpenFolder}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="open-folder" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_Terminal}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="open-terminal" />
                      </MenuItem>
                      <MenuItem Header="{x:Static loc:Strings.Sessions_Rename}"
                                IsEnabled="{Binding HasFilePath}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="rename" />
                      <MenuItem Header="{x:Static loc:Strings.Tab_MoveToTrash}"
                                IsEnabled="{Binding HasFilePath}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="trash" />
                      <MenuItem Header="{x:Static loc:Strings.Tab_Reload}"
                                IsEnabled="{Binding HasFilePath}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="reload" />
                      <Separator />
                      <MenuItem Header="{Binding ReadOnlyMenuHeader}"
                                Command="{Binding RequestActionCommand}"
                                CommandParameter="readonly" />
                      <Separator />
                      <MenuItem Header="{x:Static loc:Strings.Tab_CopyTo}">
                        <MenuItem Header="{x:Static loc:Strings.Tab_FilePath}"
                                  IsEnabled="{Binding HasFilePath}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="copy-path" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_FileName}"
                                  IsEnabled="{Binding HasFilePath}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="copy-name" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_Contents}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="copy-content" />
                      </MenuItem>
                      <MenuItem Header="{x:Static loc:Strings.Tab_MoveTab}">
                        <MenuItem Header="{x:Static loc:Strings.Tab_MoveLeft}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="move-left" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_MoveRight}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="move-right" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_MoveStart}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="move-start" />
                        <MenuItem Header="{x:Static loc:Strings.Tab_MoveEnd}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="move-end" />
                      </MenuItem>
                      <MenuItem Header="{x:Static loc:Strings.Tab_Color}">
                        <MenuItem Header="{x:Static loc:Strings.Tab_NoColor}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:none" />
                        <Separator />
                        <MenuItem Header="{x:Static loc:Strings.Color_Red}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#E06C4F" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Orange}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#E0A44A" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Yellow}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#E8D45A" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Green}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#5BD08E" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Blue}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#4A9EDB" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Purple}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#B180F0" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Pink}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#E06C9F" />
                        <MenuItem Header="{x:Static loc:Strings.Color_Gray}"
                                  Command="{Binding RequestActionCommand}"
                                  CommandParameter="color:#8A94A6" />
                      </MenuItem>
                    </MenuFlyout>
                  </Button.ContextFlyout>
                  <Panel>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                      <Border Grid.Column="0"
                              Width="3"
                              Height="18"
                              CornerRadius="1.5"
                              Background="{Binding TabColorBrush}"
                              IsVisible="{Binding HasTabColor}"
                              Margin="0,0,2,0" />
                      <Border Grid.Column="1" Classes="tab-badge" Background="{Binding LanguageSoftBrush}">
                        <TextBlock Text="{Binding ExtensionBadge}" Foreground="{Binding LanguageAccentBrush}" />
                      </Border>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Title}"
                                 MaxWidth="190"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="3"
                                  Orientation="Horizontal"
                                  Spacing="3"
                                  VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPin}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              IsVisible="{Binding IsPinned}" />
                        <Ellipse Classes="dirty"
                                 Width="7"
                                 Height="7"
                                 IsVisible="{Binding IsDirty}"
                                 VerticalAlignment="Center" />
                        <Button Classes="tabclose"
                                IsVisible="{Binding CanClose}"
                                Command="{Binding CloseCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Chrome_Close}">
                          <Path Data="{StaticResource IconClose}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Border Classes="tab-indicator" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button x:Name="TabScrollRight"
                Grid.Column="2"
                Classes="tool"
                Width="18"
                Height="26"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                IsVisible="False"
                Click="OnTabScrollRightClick"
                ToolTip.Tip="{x:Static loc:Strings.Tabs_ScrollRight}">
          <Path Data="{StaticResource IconChevronRight}" />
        </Button>

        <Border Grid.Column="3"
                Classes="toolbar-group"
                Height="36"
                Padding="1"
                Margin="6,0,0,0">
          <Button Classes="tool"
                  Width="30"
                  Height="30"
                  Command="{Binding NewDocumentCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Tool_NewFile}">
            <Path Data="{StaticResource IconPlus}" />
          </Button>
        </Border>
      </Grid>
    </Border>

    <!-- ============================ Editor area ============================ -->
    <Grid Grid.Row="3" RowDefinitions="*,Auto">
      <Grid Grid.Row="0">
        <ContentControl Content="{Binding ActiveDocument}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <views:WelcomeView IsVisible="{Binding IsWelcomeVisible}" />

        <Border IsVisible="{Binding IsFindBarOpen}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,26,0"
                Width="580">
          <Border Classes="findbar"
                  DataContext="{Binding FindReplace}"
                  x:DataType="vm:FindReplaceViewModel">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox x:Name="SearchBox"
                         Classes="find"
                         PlaceholderText="{x:Static loc:Strings.Tool_Find}"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         KeyDown="OnFindBoxKeyDown" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <ToggleButton Classes="option" Content="Aa" IsChecked="{Binding MatchCase, Mode=TwoWay}" ToolTip.Tip="{x:Static loc:Strings.Find_MatchCase}" />
                  <ToggleButton Classes="option" Content="W" IsChecked="{Binding WholeWord, Mode=TwoWay}" ToolTip.Tip="{x:Static loc:Strings.Find_WholeWord}" />
                  <ToggleButton Classes="option" Content=".*" IsChecked="{Binding UseRegex, Mode=TwoWay}" ToolTip.Tip="{x:Static loc:Strings.Find_Regex}" />
                  <ToggleButton Classes="option" Content="\t" IsChecked="{Binding UseExtendedEscapes, Mode=TwoWay}" ToolTip.Tip="{x:Static loc:Strings.Find_Extended}" />
                  <ToggleButton Classes="option" Content="Sel" FontSize="9" IsChecked="{Binding InSelection, Mode=TwoWay}" ToolTip.Tip="Search in selection" />
                  <ToggleButton Classes="option" Content="↻" FontSize="14" IsChecked="{Binding WrapAround, Mode=TwoWay}" ToolTip.Tip="Wrap around" />
                  <Button Classes="icon" Margin="4,0,0,0" Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Chrome_Close}">
                    <Path Data="{StaticResource IconClose}" />
                  </Button>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsReplaceMode}">
                <TextBox Classes="find"
                         PlaceholderText="{x:Static loc:Strings.Find_ReplacePlaceholder}"
                         Text="{Binding ReplaceText, Mode=TwoWay}"
                         KeyDown="OnFindBoxKeyDown" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Content="{x:Static loc:Strings.Find_Replace}"
                          Classes="ghost"
                          Padding="10,4"
                          FontSize="11.5"
                          Command="{Binding ReplaceCommand}" />
                  <Button Content="{x:Static loc:Strings.Find_ReplaceAll}"
                          Classes="ghost"
                          Padding="10,4"
                          FontSize="11.5"
                          Command="{Binding ReplaceAllCommand}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="icon" Command="{Binding FindPreviousCommand}" ToolTip.Tip="{x:Static loc:Strings.Find_PreviousMatch}">
                    <Path Data="{StaticResource IconChevronUp}" />
                  </Button>
                  <Button Classes="icon" Command="{Binding FindNextCommand}" ToolTip.Tip="{x:Static loc:Strings.Find_NextMatch}">
                    <Path Data="{StaticResource IconChevronDown}" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           Classes="status"
                           Classes.error="{Binding HasError}"
                           Margin="8,0"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Content="{x:Static loc:Strings.Find_All}"
                        Classes="ghost"
                        Padding="10,4"
                        FontSize="11.5"
                        Command="{Binding FindAllCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </Border>
      </Grid>

      <!-- Search results -->
      <Border Grid.Row="1"
              IsVisible="{Binding FindReplace.IsResultsOpen}"
              Height="220"
              Background="{DynamicResource ChromeBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="14,8,10,6">
            <TextBlock Text="{x:Static loc:Strings.Find_Results}" Classes="section-title" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding FindReplace.CloseResultsCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Find_CloseResults}">
              <Path Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <ListBox x:Name="SearchResultsList"
                   Grid.Row="1"
                   ItemsSource="{Binding FindReplace.Results}"
                   SelectionChanged="OnSearchResultSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchResultItem">
                <Grid ColumnDefinitions="118,*" ColumnSpacing="12" Margin="2,1">
                  <TextBlock Text="{Binding Location}"
                             FontSize="11.5"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Preview}"
                             FontSize="11.5"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================ Status bar ============================ -->
    <Border Grid.Row="4"
            Background="{DynamicResource StatusBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,3"
            IsVisible="{Binding HasDocuments}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="13">
          <TextBlock Text="{Binding StatusMessage}"
                     Classes="status"
                     MaxWidth="220"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusCaretLine, StringFormat='Ln {0}'}" Classes="status" />
          <TextBlock Text="{Binding StatusCaretColumn, StringFormat='Col {0}'}" Classes="status" />
          <TextBlock Text="{Binding StatusSelectionLength, StringFormat='Sel {0}'}" Classes="status" />
          <TextBlock Text="{Binding StatusLinesText}" Classes="status" />
          <TextBlock Text="{Binding StatusLengthText}" Classes="status" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <ComboBox Classes="status"
                    ItemsSource="{Binding EncodingOptions}"
                    SelectedItem="{Binding StatusEncoding, Mode=TwoWay}"
                    ToolTip.Tip="{x:Static loc:Strings.Status_SaveEncoding}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:EncodingOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Classes="status"
                    ItemsSource="{Binding LineEndingOptions}"
                    SelectedItem="{Binding StatusLineEnding, Mode=TwoWay}"
                    ToolTip.Tip="{x:Static loc:Strings.Status_LineEndings}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:LineEndingOption">
                <TextBlock Text="{Binding ShortName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Classes="status-chip" ToolTip.Tip="{x:Static loc:Strings.Status_Zoom}">
            <TextBlock Text="{Binding StatusZoom}"
                       Classes="status"
                       MinWidth="40"
                       TextAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
