<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NotepadMoreOS.ViewModels"
             xmlns:views="using:NotepadMoreOS.Views"
             x:Class="NotepadMoreOS.App"
             Name="NotepadMoreOS"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
      <views:DocumentView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NotepadMoreOS/Styles/Palette.axaml" />
        <ResourceInclude Source="avares://NotepadMoreOS/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://NotepadMoreOS/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
